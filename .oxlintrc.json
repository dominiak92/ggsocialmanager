{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Nieaktualne przy automatycznym runtime JSX (tsconfig: "jsx": "react-jsx").
    // React nie musi być w zasięgu — kompilator wstrzykuje `jsx()` sam.
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": "error"
  },
  "overrides": [
    {
      // Wygenerowany kod shadcn celowo eksportuje warianty (cva) obok komponentu.
      // To ich konwencja — nie przepisujemy jej, żeby dało się aktualizować komponenty.
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "coverage", "src/lib/database.types.ts"]
}
