# Skopiuj do .env.local i uzupełnij wartościami z panelu Supabase
# (Project Settings → API). Oba klucze są PUBLICZNE — trafiają do bundla
# frontendowego. NIGDY nie wstawiaj tu service_role key.
#
# Uwaga: to TO SAMO konto Supabase co groundgamelab, ale INNY projekt
# (własna baza, własny schemat `ggsm`). Nie kopiuj wartości z tamtego projektu.
VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=

# Hasło do bramki wejściowej (login: `admin`). Gdy puste, bramka jest wyłączona.
# UWAGA: to zasłona, nie zamek — wartość trafia do bundla JS, a dane i tak są
# dostępne przez publiczne API Supabase. Patrz AGENTS.md → „Dostęp do danych".
VITE_APP_PASSWORD=

# Używane tylko lokalnie przez `npm run db:types` i Supabase CLI, nie przez aplikację.
SUPABASE_PROJECT_ID=
# Personal Access Token (sbp_...) — do `supabase link`, `db push`, `gen types`.
SUPABASE_ACCESS_TOKEN=
# Hasło do bazy — wymagane przez `supabase db push`.
SUPABASE_DB_PASSWORD=
